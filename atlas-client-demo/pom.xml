<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.datadynamics.atlas</groupId>
        <artifactId>atlas-client-parent</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>atlas-client-demo</artifactId>
    <name>Atlas Client :: Demo</name>
    <description>Spring Boot web demo that exercises the client against a running Atlas</description>

    <properties>
        <spring-boot.version>4.0.9</spring-boot.version>
        <!-- Spring Boot의 Jackson 3는 jackson-annotations를 Jackson 2와 함께 쓰며 2.21 버전이 필요합니다.
             그래서 부모 POM의 버전 대신 Spring Boot가 관리하는 Jackson 2 버전을 씁니다. -->
        <jackson.version>2.21.7</jackson.version>
        <mermaid.version>11.17.2</mermaid.version>
        <monaco-editor.version>0.55.1</monaco-editor.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.datadynamics.atlas</groupId>
            <artifactId>atlas-client-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.atlas</groupId>
            <artifactId>atlas-client-typedef</artifactId>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.atlas</groupId>
            <artifactId>atlas-client-lineage</artifactId>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.atlas</groupId>
            <artifactId>atlas-client-kafka</artifactId>
        </dependency>
        <!-- ConsistencyChecker와 EntityFiles를 쓰기 위한 의존성입니다. -->
        <dependency>
            <groupId>io.datadynamics.atlas</groupId>
            <artifactId>atlas-client-cli</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>info.picocli</groupId>
                    <artifactId>picocli</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 템플릿에서 버전 번호 없는 /webjars/ 경로를 쓸 수 있게 합니다. -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>webjars-locator-lite</artifactId>
        </dependency>
        <!-- 번들된 dist 파일만 쓰므로 mermaid의 npm 의존성은 필요하지 않습니다. -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>mermaid</artifactId>
            <version>${mermaid.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 코드 보기와 편집기(min/vs AMD 빌드)입니다. npm 의존성은 번들에 포함되어 있습니다. -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>monaco-editor</artifactId>
            <version>${monaco-editor.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.atlas</groupId>
            <artifactId>atlas-client-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>atlas-client-demo</finalName>
        <plugins>
            <plugin>
                <!-- Spring은 요청 파라미터를 메서드 파라미터 이름으로 바인딩하므로, 컴파일할 때 파라미터 이름을 남겨야 합니다. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
